{
  "name": "stockroom-inventory",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "promote-admin": "npm run promote-admin -w backend --",
    "test": "npm test -w backend"
  },
  "devDependencies": {"concurrently": "^9.2.1"},
  "engines": {"node": ">=20.19"}
}
