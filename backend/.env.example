NODE_ENV=development
PORT=5000
# Paste your MongoDB connection string here (local or Atlas).
MONGO_URI=
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
